<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#171A1F"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#20242B"/>
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#292F38"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#242A32"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#596471"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F3F6"/>
    <SolidColorBrush x:Key="ComboBoxTextBrush" Color="#18212B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB5C0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#46505B"/>
    <SolidColorBrush x:Key="UsageTrackBrush" Color="#3A424C"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#42B8B0"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#254C50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F1C56B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#242A32"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#303740"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#596471"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F0F3F6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#20242B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F0F3F6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#254C50"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7F8994"/>
</ResourceDictionary>
