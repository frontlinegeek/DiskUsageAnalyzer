<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#E7ECF1"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#AAB4BE"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18212B"/>
    <SolidColorBrush x:Key="ComboBoxTextBrush" Color="#18212B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#637180"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#D6DDE5"/>
    <SolidColorBrush x:Key="UsageTrackBrush" Color="#DFE4E8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#197E79"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#CDE8E6"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#916300"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#A33A2A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F0F2F4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#AAB4BE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#18212B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#18212B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#197E79"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#637180"/>
</ResourceDictionary>
